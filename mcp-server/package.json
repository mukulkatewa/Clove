{
  "name": "@cloveos/mcp-server",
  "version": "2.0.2",
  "description": "CLOVE MCP Server — full kernel coverage, dual stdio/HTTP transport",
  "type": "module",
  "bin": {
    "clove-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "PORT=3001 node dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
