# URL of the running CLOVE kernel
# Local:   http://localhost:8080
# Railway: http://<kernel-service>.railway.internal:8080
CLOVE_API_URL=http://localhost:8080

# Auth token for HTTP mode — clients must send:
#   Authorization: Bearer <CLOVE_MCP_KEY>
# Leave empty to disable auth (not recommended in production)
CLOVE_MCP_KEY=your-secret-key-here

# Set PORT to enable HTTP mode (required for Railway / remote hosting)
# Leave unset for stdio mode (local Claude Code)
PORT=3001
